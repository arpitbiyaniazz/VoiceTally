# ─── Database ───
DATABASE_URL=postgresql://voicetally:voicetally_dev@localhost:5432/voicetally
POSTGRES_USER=voicetally
POSTGRES_PASSWORD=voicetally_dev
POSTGRES_DB=voicetally

# ─── Redis ───
REDIS_URL=redis://localhost:6379

# ─── Auth ───
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── API Server ───
API_PORT=3001
NODE_ENV=development

# ─── Frontend ───
VITE_API_URL=http://localhost:3001/api

# ─── LLM Voice Agent Function Calling ───
# Active provider choice: 'mistral' | 'gemini' | 'openai' (or auto-detected from active key)
LLM_PROVIDER=mistral

# Mistral AI Configuration
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
