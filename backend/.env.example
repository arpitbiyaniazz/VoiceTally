# ─── Database ───
DATABASE_URL=postgresql://voicetally:voicetally_dev@localhost:5432/voicetally
POSTGRES_USER=voicetally
POSTGRES_PASSWORD=voicetally_dev
POSTGRES_DB=voicetally

# ─── Redis ───
REDIS_URL=redis://localhost:6379

# ─── Auth ───
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── API Server ───
API_PORT=3001
NODE_ENV=development

# ─── Frontend ───
VITE_API_URL=http://localhost:3001/api

# ─── LLM Voice Agent Function Calling ───
# Active provider choice: 'mistral' | 'gemini' | 'openai' (or auto-detected from active key).
# 'local' uses only the built-in parser (no LLM calls) — tests run this way.
LLM_PROVIDER=mistral
# Request timeout in ms; the built-in parser answers if the model is slow or unavailable
LLM_TIMEOUT_MS=8000

# Mistral AI Configuration
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest
# Tried in order when MISTRAL_MODEL has no quota on your plan (HTTP 429 with a 0/min limit, or 403)
MISTRAL_FALLBACK_MODELS=ministral-8b-latest

# Voxtral speech (uses MISTRAL_API_KEY)
# Recorded-audio transcription model; realtime-only models are mapped to voxtral-mini-latest
VOXTRAL_STT_MODEL=voxtral-mini-latest
VOXTRAL_TTS_MODEL=voxtral-mini-tts-2603
# Voice persona (neutral_female | cheerful_female | casual_female) or a hosted voice slug like gb_jane_neutral
VOXTRAL_VOICE_ID=neutral_female

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
